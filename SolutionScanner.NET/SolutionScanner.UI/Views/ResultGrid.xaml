<UserControl x:Class="SolutionScanner.UI.Views.ResultGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Margin="2,2,2,4" Foreground="{StaticResource MutedBrush}">
            <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
            <Run Text=" – rekordów: "/>
            <Run Text="{Binding CountText, Mode=OneWay}"/>
        </TextBlock>
        <DataGrid ItemsSource="{Binding View}" AutoGeneratingColumn="OnAutoGeneratingColumn"/>
    </DockPanel>
</UserControl>
